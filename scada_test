    // ==================== SIMULATED TIMESERIES TELEMETRY GENERATOR ====================
    function generateSimulatedTelemetry(type, size = 60) {
      const data = [];
      const now = Date.now();
      for (let i = 0; i < size; i++) {
        const timestamp = new Date(now + i * 2000).toLocaleTimeString();
        const values = {};
        const flags = {};

        if (type === 'water_filtration') {
          const inletActive = i % 20 < 14;
          const washActive = i % 20 >= 14 && i % 20 < 18;
          const rawLvl = Math.max(10, 85 - (i % 20) * 3 + (inletActive ? 1.5 : 0));
          const clnLvl = Math.min(95, 20 + (i % 20) * 3.5 - (washActive ? 4 : 0));
          const ph = 7.0 + Math.sin(i / 3) * 0.8 + (i === 25 ? 2.5 : 0);
          const turb = 1.2 + Math.cos(i / 4) * 0.5 + (i >= 40 && i <= 45 ? 5.5 : 0);

          values['RAW_LVL'] = Number(rawLvl.toFixed(1));
          values['CLN_LVL'] = Number(clnLvl.toFixed(1));
          values['PH_SENS'] = Number(ph.toFixed(2));
          values['TURB_SENS'] = Number(turb.toFixed(2));
          values['FLOW_SENS'] = inletActive ? Number((250 + Math.sin(i) * 15).toFixed(1)) : 0;
          values['IN_PUMP'] = inletActive ? 1 : 0;
          values['BW_PUMP'] = washActive ? 1 : 0;
          values['FEED_VALVE'] = inletActive ? 1 : 0;
          values['DRAIN_VALVE'] = washActive ? 1 : 0;

          if (ph > 8.5) flags['PH_SENS'] = 'W';
          if (ph > 9.2) flags['PH_SENS'] = 'B';
          if (turb > 3.0) flags['TURB_SENS'] = 'W';
          if (turb > 5.0) flags['TURB_SENS'] = 'B';
          if (rawLvl < 20) flags['RAW_LVL'] = 'W';
          if (clnLvl > 90) flags['CLN_LVL'] = 'W';

        } else if (type === 'chemical_reactor') {
          const agitatorActive = i >= 10 && i < 50 ? 1 : 0;
          const heatValve = i < 25 ? 1 : 0;
          const coolValve = i >= 35 && i < 50 ? 1 : 0;
          
          let temp = i < 25 ? 25 + i * 4.5 : i < 40 ? 137.5 + Math.sin(i) * 2 : i < 50 ? 137.5 - (i - 40) * 10 : Math.max(25, 37.5 - (i - 50) * 1.2);
          let pressure = i < 25 ? 1.0 + (temp - 25) * 0.05 : i < 40 ? 6.6 + Math.cos(i) * 0.4 + (i === 30 ? 3.5 : 0) : i < 50 ? 6.6 - (i - 40) * 0.5 : 1.0;
          let level = i < 15 ? 10 + i * 5.5 : i < 50 ? 92.5 + Math.sin(i / 2) * 0.5 : Math.max(10, 92.5 - (i - 50) * 8.2);

          values['RX_LVL'] = Number(level.toFixed(1));
          values['TEMP_SENS'] = Number(temp.toFixed(1));
          values['PRES_SENS'] = Number(pressure.toFixed(2));
          values['AGITATOR'] = agitatorActive;
          values['HEAT_VLV'] = heatValve;
          values['COOL_VLV'] = coolValve;

          if (temp > 130) flags['TEMP_SENS'] = 'W';
          if (temp > 145) flags['TEMP_SENS'] = 'B';
          if (pressure > 6.0) flags['PRES_SENS'] = 'W';
          if (pressure > 8.0) flags['PRES_SENS'] = 'B';

        } else { // steam_boiler
          const pumpActive = i % 15 < 7;
          const steamValveOpen = i >= 10;
          let boilerPrs = i < 10 ? 1.0 + i * 1.5 : 16.0 + Math.sin(i / 2) * 2.0 + (i === 35 ? 7.5 : 0);
          let steamTemp = i < 10 ? 100 + i * 15 : 250 + Math.sin(i) * 5;
          let drumLvl = pumpActive ? Math.min(85, 45 + (i % 15) * 5.0) : Math.max(30, 80 - ((i % 15) - 7) * 4.5);

          values['DRUM_LVL'] = Number(drumLvl.toFixed(1));
          values['BOILER_PRS'] = Number(boilerPrs.toFixed(2));
          values['STEAM_TMP'] = Number(steamTemp.toFixed(1));
          values['STEAM_FLW'] = steamValveOpen ? Number((boilerPrs * 12.5 + Math.cos(i) * 10).toFixed(1)) : 0;
          values['FEED_PUMP'] = pumpActive ? 1 : 0;
          values['STEAM_VLV'] = steamValveOpen ? 1 : 0;

          if (boilerPrs > 18.0) flags['BOILER_PRS'] = 'W';
          if (boilerPrs > 22.0) flags['BOILER_PRS'] = 'B';
          if (steamTemp > 255) flags['STEAM_TMP'] = 'W';
          if (drumLvl < 35 || drumLvl > 80) flags['DRUM_LVL'] = 'W';
        }

        data.push({ timestamp, values, flags });
      }
      return data;
    }

