<!DOCTYPE html>
<html lang="en">
<head>
  <script type="module" src="/@vite/client"></script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Standalone SCADA HMI Simulator & Designer</title>
  <!-- Tailwind CSS CDN for elegant styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0b0f17;
      color: #cbd5e1;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    /* Simple scrollbar theme */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
  </style>
<script src="/_aistudio-iframe.js?v=1ee22f18"></script></head>
<body class="min-h-screen flex flex-col justify-between overflow-x-hidden">

  <!-- ==================== HEADER PANEL ==================== -->
  <header class="bg-[#111622] border-b border-slate-800 px-6 py-3 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-50 shadow-lg">
    <div class="flex items-center gap-3">
      <div class="h-8 w-8 rounded bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white font-bold text-sm shadow-[0_0_12px_rgba(16,185,129,0.3)]">
        SC
      </div>
      <div>
        <h1 class="text-xs font-bold text-white tracking-wider uppercase font-mono leading-none">
          Industrial SCADA | Terminal
        </h1>
        <span class="text-[9px] font-mono font-bold text-emerald-400 tracking-widest">
          STANDALONE OFFLINE SUITE v3.0
        </span>
      </div>
    </div>

    <!-- Central Navigation and Controls -->
    <div class="flex items-center gap-4">
      <!-- Mode Toggle Switch -->
      <div class="bg-slate-950 p-1 rounded-md border border-slate-800 flex">
        <button id="btn-monitor-mode" onclick="setViewMode('monitor')" class="px-4 py-1.5 rounded text-xs font-bold transition-all bg-emerald-600 text-white shadow">
          HMI Monitor
        </button>
        <button id="btn-designer-mode" onclick="setViewMode('designer')" class="px-4 py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white">
          HMI Designer
        </button>
      </div>

      <!-- Layout Picker (Monitor Only) -->
      <div id="layout-picker-container" class="relative">
        <select id="layout-selector" onchange="changeActiveLayout(this.value)" class="bg-[#1e293b] border border-slate-700 text-slate-200 px-3 py-1.5 rounded text-xs font-bold outline-none focus:border-emerald-500 transition-colors cursor-pointer">
          <!-- Options injected dynamically -->
        </select>
      </div>

      <!-- JSON Telemetry File Loader -->
      <div id="json-loader-container" class="flex items-center gap-2">
        <button onclick="document.getElementById('file-loader').click()" class="bg-[#1e293b] hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-bold px-3 py-1.5 rounded flex items-center gap-1.5 transition-all">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
          Load JSON
        </button>
        <input type="file" id="file-loader" accept=".json" onchange="handleJsonTelemetryUpload(event)" class="hidden">
      </div>
    </div>

    <!-- Active UTC Timestamp -->
    <div class="bg-slate-950 border border-slate-800 px-3 py-1.5 rounded text-xs font-mono font-medium text-slate-300 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span id="utc-clock">00:00:00 UTC</span>
    </div>
  </header>

  <!-- ==================== MAIN CONTENT AREA ==================== -->
  <main class="flex-grow w-full max-w-[1400px] mx-auto px-6 py-6 grid grid-cols-1 xl:grid-cols-4 gap-6">

    <!-- LEFT COLUMN: CONTEXT METADATA & DESIGNER PALETTE -->
    <div class="xl:col-span-1 space-y-5">
      <!-- Layout Metadata Details -->
      <div id="meta-panel" class="bg-[#111622] border border-slate-800/80 rounded-xl p-5 shadow-lg">
        <span class="font-mono text-[9px] font-bold text-emerald-400 bg-emerald-950/40 border border-emerald-800 px-2.5 py-1 rounded uppercase tracking-wider">
          Node Controller Schema
        </span>
        <h2 id="meta-title" class="text-base font-bold text-white tracking-tight mt-3">
          Loading Active Schematic...
        </h2>
        <p id="meta-desc" class="text-slate-400 text-xs leading-relaxed mt-2">
          HMI synoptic layouts update automatically to stream physical register registers, pipe pressure lines, and alarm thresholds.
        </p>
        <!-- Compact Alarms Diagnostics Container (Contained directly inside the SCADA HMI context) -->
        <div class="mt-4 pt-4 border-t border-slate-800/80 space-y-2">
          <span class="text-[10px] font-mono font-bold text-slate-500 block uppercase tracking-wider">Active Loop Metrics</span>
          <div class="grid grid-cols-2 gap-2">
            <div class="bg-slate-950 border border-slate-900 rounded p-2.5">
              <span class="text-[8px] font-mono text-slate-500 block uppercase">Signal Tags</span>
              <span id="stat-tags-count" class="font-mono font-bold text-sm text-slate-300">0</span>
            </div>
            <div class="bg-slate-950 border border-slate-900 rounded p-2.5">
              <span class="text-[8px] font-mono text-slate-500 block uppercase">Alarms Active</span>
              <span id="stat-alarms-active" class="font-mono font-bold text-sm text-emerald-400">0 ACT</span>
            </div>
          </div>
        </div>
      </div>

      <!-- DESIGNER CONTROLS TOOLBOX (Hidden by default in Monitor mode) -->
      <div id="designer-tools-panel" class="bg-[#111622] border border-slate-800/80 rounded-xl p-5 shadow-lg space-y-4 hidden animate-fade-in">
        <h3 class="font-mono text-xs font-bold text-slate-300 uppercase tracking-wider border-b border-slate-800 pb-2 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded bg-amber-500"></span> HMI Builder Palette
        </h3>

        <!-- Tool Selection Button Grid -->
        <div class="grid grid-cols-2 gap-2">
          <button onclick="setDesignerTool('select')" id="tool-select" class="flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-amber-600 border border-amber-500 text-white shadow-md transition-all">
            Cursor Select
          </button>
          <button onclick="setDesignerTool('tank')" id="tool-tank" class="flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-[#1e293b] border border-slate-700 hover:bg-slate-700 text-slate-300 transition-all">
            + Place Tank
          </button>
          <button onclick="setDesignerTool('pump')" id="tool-pump" class="flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-[#1e293b] border border-slate-700 hover:bg-slate-700 text-slate-300 transition-all">
            + Place Pump
          </button>
          <button onclick="setDesignerTool('valve')" id="tool-valve" class="flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-[#1e293b] border border-slate-700 hover:bg-slate-700 text-slate-300 transition-all">
            + Place Valve
          </button>
          <button onclick="setDesignerTool('scale')" id="tool-scale" class="flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-[#1e293b] border border-slate-700 hover:bg-slate-700 text-slate-300 transition-all">
            + Place Scale
          </button>
          <button onclick="setDesignerTool('pipe')" id="tool-pipe" class="flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-[#1e293b] border border-slate-700 hover:bg-slate-700 text-slate-300 transition-all">
            + Draw Pipe
          </button>
        </div>

        <!-- Pipe Drawing Feedback Block -->
        <div id="pipe-feedback" class="p-3 bg-sky-950/30 border border-sky-800/50 rounded-lg text-xs hidden">
          <p class="text-sky-400 font-medium mb-2 leading-normal">
            <strong>Pipe Drawing Mode:</strong> Left-click multiple points on the blueprint map to draft the pipe segment. Press Finish when done.
          </p>
          <button onclick="finishDrawingPipe()" class="w-full bg-sky-600 hover:bg-sky-500 text-white font-mono text-[10px] py-1 px-2.5 rounded font-bold transition-all">
            Finish Drawing Pipe (<span id="pipe-points-count">0</span> nodes)
          </button>
        </div>

        <!-- Blueprint Upload & Scale Settings -->
        <div class="space-y-3 pt-2">
          <div>
            <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Grid Dimension Bounds</label>
            <div class="grid grid-cols-2 gap-2">
              <input type="number" id="designer-grid-w" value="1000" onchange="updateDesignerGridSize()" class="bg-slate-950 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-slate-300 outline-none w-full">
              <input type="number" id="designer-grid-h" value="600" onchange="updateDesignerGridSize()" class="bg-slate-950 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-slate-300 outline-none w-full">
            </div>
          </div>

          <div>
            <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Background Blueprint Layout</label>
            <button onclick="document.getElementById('blueprint-loader').click()" class="w-full bg-[#1e293b] hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs font-bold py-1.5 px-3 rounded flex items-center justify-center gap-1.5 transition-all">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375 0 11-.75 0 .375 0 01.75 0z"/></svg>
              Upload Schematic Image
            </button>
            <input type="file" id="blueprint-loader" accept="image/*" onchange="handleBlueprintUpload(event)" class="hidden">
          </div>
        </div>
      </div>
    </div>

    <!-- CENTER COLUMN: INTERACTIVE SCADA SCHEMA CANVAS & TIMELINE -->
    <div class="xl:col-span-2 flex flex-col justify-between space-y-4">

      <!-- SCADA VIEWPORT CABINET -->
      <div class="bg-[#111622] border border-slate-800/80 rounded-xl shadow-2xl p-4 flex flex-col relative min-h-[480px]">
        <!-- Active alarm badge or drawing hint indicator banner inside viewport header -->
        <div class="flex items-center justify-between border-b border-slate-800/60 pb-3 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981]" id="status-glow"></span>
            <span id="viewport-subheading" class="font-mono text-[10px] font-bold text-slate-400 uppercase tracking-wider">
              HMI Process Synoptic Graphic
            </span>
          </div>
          <span id="canvas-dim" class="font-mono text-[9px] text-slate-500">
            Resolution: 1000x600
          </span>
        </div>

        <!-- Interactive SVG Viewport -->
        <div class="flex-grow flex items-center justify-center bg-slate-950 rounded-lg border border-slate-900 overflow-hidden relative">
          <!-- Main Interactive SVG -->
          <svg id="hmi-svg" viewBox="0 0 1000 600" onclick="handleCanvasInteraction(event)" class="w-full h-auto select-none bg-slate-950 max-h-[500px]">
            <!-- Dynamic definitions -->
            <defs>
              <pattern id="grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 255, 255, 0.03)" stroke-width="1"/>
              </pattern>
            </defs>
            <!-- Grid Background -->
            <rect width="100%" height="100%" fill="url(#grid-pattern)" />
            <!-- SVG Image Blueprint background (for Designer layout drafting) -->
            <image id="designer-bg-image" width="1000" height="600" opacity="0.35" style="display: none;"></image>
            
            <!-- Structural containers injected dynamically via JS renderers -->
            <g id="pipes-group"></g>
            <g id="tanks-group"></g>
            <g id="valves-group"></g>
            <g id="pumps-group"></g>
            <g id="sensors-group"></g>
          </svg>

          <!-- Simple Hover Tooltip (Fully offline, absolutely positioned inside cabinet) -->
          <div id="hmi-tooltip" class="absolute z-40 bg-[#161f30] border border-slate-700 text-slate-100 p-3 rounded-md shadow-2xl w-64 pointer-events-none text-xs opacity-0 transition-opacity duration-150">
            <!-- Content built on hover -->
          </div>
        </div>
      </div>

      <!-- PLAYBACK CONTROLS (Monitor Mode) or EXPORTER (Designer Mode) -->
      <div id="monitor-controls" class="bg-[#111622] border border-slate-800/80 rounded-xl p-4 shadow-lg flex items-center justify-between gap-4">
        <!-- Playback Actions -->
        <div class="flex items-center gap-1.5">
          <button id="btn-play-pause" onclick="togglePlayback()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-[10px] font-bold px-3 py-1.5 rounded transition-all">
            PAUSE
          </button>
          <button onclick="stepFrame()" class="p-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-slate-300" title="Step Frame Forward">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25V18a.75.75 0 001.22.58l9.75-8.25a.75.75 0 000-1.16L4.22 1a.75.75 0 00-1.22.58v6.67m10.5 0V18a.75.75 0 001.22.58l9.75-8.25a.75.75 0 000-1.16L14.72 1a.75.75 0 00-1.22.58v6.67"/></svg>
          </button>
          <button onclick="resetPlayback()" class="p-1.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-slate-300" title="Rewind to Frame 0">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
          </button>
        </div>

        <!-- Scrubber and Timeline Progress indicator -->
        <div class="flex-grow flex items-center gap-3">
          <span id="frame-indicator" class="text-[9px] font-mono font-bold text-slate-500 whitespace-nowrap">
            FRAME 1/60
          </span>
          <input type="range" id="playback-scrubber" min="0" max="59" value="0" oninput="scrubTimeline(this.value)" class="w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500 outline-none">
          <span id="frame-timestamp" class="text-emerald-400 font-mono font-bold tabular-nums text-xs whitespace-nowrap">
            00:00:00
          </span>
        </div>

        <!-- Speed Factor Dropdown -->
        <div class="flex items-center gap-1.5">
          <span class="text-[8px] font-mono font-bold text-slate-500 hidden sm:inline">SPEED</span>
          <select id="speed-selector" onchange="changePlaybackSpeed(this.value)" class="bg-[#1e293b] border border-slate-700 text-slate-300 text-xs px-2 py-1 rounded font-mono outline-none cursor-pointer">
            <option value="0.5">0.5x</option>
            <option value="1" selected>1.0x</option>
            <option value="2">2.0x</option>
            <option value="5">5.0x</option>
            <option value="10">10.0x</option>
          </select>
        </div>
      </div>

      <!-- DESIGN CODE EXPORTER BOX (Hidden by default in Monitor mode) -->
      <div id="designer-code-box" class="bg-[#111622] border border-slate-800/80 rounded-xl p-5 shadow-lg space-y-3 hidden">
        <div class="flex items-center justify-between">
          <h4 class="font-mono text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-2 h-2 rounded bg-sky-500 animate-pulse"></span> Exported layout JS Configuration block
          </h4>
          <button onclick="copyLayoutCode()" class="bg-[#1e293b] hover:bg-slate-700 border border-slate-700 text-slate-300 text-[10px] font-mono py-1 px-2.5 rounded transition-all">
            Copy Code Block
          </button>
        </div>
        <textarea id="output-layout-json" readonly class="w-full bg-slate-950 border border-slate-900 rounded p-3 text-[10px] font-mono text-slate-400 h-32 resize-none leading-relaxed outline-none"></textarea>
      </div>

    </div>

    <!-- RIGHT COLUMN: DETAILED ASSET INSPECTOR -->
    <div class="xl:col-span-1">
      <div class="bg-[#111622] border border-slate-800/80 rounded-xl p-5 shadow-lg min-h-[480px] flex flex-col justify-between">
        <div>
          <h3 class="font-mono text-xs font-bold text-slate-300 uppercase tracking-wider border-b border-slate-800 pb-2 mb-4 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded bg-emerald-500"></span> Asset Calibration Inspector
          </h3>

          <!-- Selection Empty State -->
          <div id="inspector-empty" class="py-16 text-center space-y-2">
            <svg class="w-8 h-8 text-slate-600 mx-auto opacity-50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"/></svg>
            <p class="font-mono text-xs text-slate-500">No Asset Selected</p>
            <p class="text-[10px] text-slate-600 leading-normal max-w-[180px] mx-auto">
              Select any highlighted active process asset on the SVG synoptic layout to inspect registers or configure.
            </p>
          </div>

          <!-- Dynamic Calibration Fields (Shown only when asset is selected) -->
          <div id="inspector-form" class="space-y-4 hidden">
            <div class="p-2.5 bg-slate-950 border border-slate-900 rounded-lg">
              <span id="inspector-asset-type" class="text-[9px] font-mono font-bold text-emerald-400 uppercase tracking-widest block">TANK</span>
              <span id="inspector-asset-tag" class="font-mono text-xs font-bold text-slate-100">DRUM_LVL</span>
            </div>

            <div class="space-y-3">
              <div>
                <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Friendly Display Label</label>
                <input type="text" id="inspect-label" oninput="updateActiveAssetField('name', this.value)" class="bg-slate-950 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-slate-200 outline-none w-full">
              </div>

              <!-- Digital Valve-specific orientation selector -->
              <div id="inspect-valve-fields" class="hidden">
                <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Actuator Orientation</label>
                <select id="inspect-valve-orient" onchange="updateActiveAssetField('orientation', this.value)" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs px-2.5 py-1.5 rounded outline-none w-full">
                  <option value="horizontal">Horizontal (Flat-bed)</option>
                  <option value="vertical">Vertical (Upright)</option>
                </select>
              </div>

              <!-- Pump-specific flow direction selector -->
              <div id="inspect-pump-fields" class="hidden">
                <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Impeller Arrow Direction</label>
                <select id="inspect-pump-flow" onchange="updateActiveAssetField('flowDirection', this.value)" class="bg-slate-950 border border-slate-800 text-slate-300 text-xs px-2.5 py-1.5 rounded outline-none w-full">
                  <option value="right">To the Right (East)</option>
                  <option value="left">To the Left (West)</option>
                  <option value="up">Going Up (North)</option>
                  <option value="down">Going Down (South)</option>
                </select>
              </div>

              <!-- Tank-specific limits settings -->
              <div id="inspect-tank-fields" class="hidden grid grid-cols-2 gap-2">
                <div>
                  <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Max Capacity</label>
                  <input type="number" id="inspect-tank-cap" oninput="updateActiveAssetField('maxCapacity', Number(this.value))" class="bg-slate-950 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-slate-200 outline-none w-full">
                </div>
                <div>
                  <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Unit Weight</label>
                  <input type="text" id="inspect-tank-unit" oninput="updateActiveAssetField('unit', this.value)" class="bg-slate-950 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-slate-200 outline-none w-full">
                </div>
              </div>

              <!-- Shared analogue scale parameters calibration -->
              <div id="inspect-sensor-fields" class="border-t border-slate-800 pt-3 mt-3 space-y-3 hidden">
                <span class="text-[9px] font-mono font-bold text-slate-400 uppercase tracking-wider block">Scale Calibration (analogue)</span>
                
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Engineering Min</label>
                    <input type="number" id="inspect-scale-min" oninput="updateActiveSensorField('scaleMin', Number(this.value))" class="bg-slate-950 border border-slate-800 rounded px-2 py-1 text-[10px] text-slate-200 outline-none w-full">
                  </div>
                  <div>
                    <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Engineering Max</label>
                    <input type="number" id="inspect-scale-max" oninput="updateActiveSensorField('scaleMax', Number(this.value))" class="bg-slate-950 border border-slate-800 rounded px-2 py-1 text-[10px] text-slate-200 outline-none w-full">
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Warning Low</label>
                    <input type="number" id="inspect-warn-low" oninput="updateActiveSensorThreshold('warningLow', Number(this.value))" class="bg-slate-950 border border-slate-800 rounded px-2 py-1 text-[10px] text-slate-200 outline-none w-full">
                  </div>
                  <div>
                    <label class="text-[9px] font-bold uppercase text-slate-500 block mb-1">Warning High</label>
                    <input type="number" id="inspect-warn-high" oninput="updateActiveSensorThreshold('warningHigh', Number(this.value))" class="bg-slate-950 border border-slate-800 rounded px-2 py-1 text-[10px] text-slate-200 outline-none w-full">
                  </div>
                </div>
              </div>

              <!-- Shared Asset Registry Description Details -->
              <div>
