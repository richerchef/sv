    // ==================== INITIALIZATION ====================
    function init() {
      // Load layouts
      state.layouts = JSON.parse(JSON.stringify(layoutPresets));
      
      // Inject dropdown options
      const selector = document.getElementById('layout-selector');
      selector.innerHTML = state.layouts.map(l => `<option value="${l.id}">${l.name}</option>`).join('');

      // Populate timeseries telemetry data
      changeActiveLayout(state.activeLayoutId);

      // Start tick clock loop
      setInterval(updateRotationAngle, 30);
      setInterval(updateUtcClock, 1000);

      // Trigger standard render
      render();
    }

    // ==================== PROCESS LOOPS & UTCS ====================
    function updateRotationAngle() {
      if (state.viewMode === 'monitor' && state.isPlaying) {
        // Increment impeller speed based on playback multipliers
        state.rotationAngle = (state.rotationAngle + (10 * state.playbackSpeed)) % 360;
        
        // Directly rotate the impellers via fast JS selectors to bypass heavy React renders
        const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
        if (activeLayout) {
          activeLayout.pumps.forEach(p => {
            const el = document.getElementById(`impeller-${p.id}`);
            if (el) {
              const activeData = state.timeseries[state.playbackIndex];
              const isTurnedOn = activeData && activeData.values[p.controlSensorId] === 1;
              el.setAttribute('transform', `rotate(${isTurnedOn ? state.rotationAngle : 0}, ${p.x + p.width/2}, ${p.y + p.height/2})`);
            }
          });
        }
      }
    }

    function updateUtcClock() {
      const now = new Date();
      document.getElementById('utc-clock').textContent = now.toUTCString().slice(17, 25) + ' UTC';
    }

    // ==================== VIEW MODES & INTERACTIVE CONTROLS ====================
    function setViewMode(mode) {
      state.viewMode = mode;
      
      // Toggle styling of buttons
      const btnMon = document.getElementById('btn-monitor-mode');
      const btnDes = document.getElementById('btn-designer-mode');
      const picker = document.getElementById('layout-picker-container');
      const jsonLd = document.getElementById('json-loader-container');
      const sideMeta = document.getElementById('meta-panel');
      const sidePal = document.getElementById('designer-tools-panel');
      const monCtrls = document.getElementById('monitor-controls');
      const codeBox = document.getElementById('designer-code-box');

      if (mode === 'monitor') {
        btnMon.className = "px-4 py-1.5 rounded text-xs font-bold transition-all bg-emerald-600 text-white shadow";
        btnDes.className = "px-4 py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white";
        picker.style.display = 'block';
        jsonLd.style.display = 'flex';
        sideMeta.style.display = 'block';
        sidePal.classList.add('hidden');
        monCtrls.style.display = 'flex';
        codeBox.classList.add('hidden');
        document.getElementById('designer-bg-image').style.display = 'none';
        document.getElementById('canvas-dim').textContent = `Resolution: 1000x600`;
      } else {
        btnMon.className = "px-4 py-1.5 rounded text-xs font-bold transition-all text-slate-400 hover:text-white";
        btnDes.className = "px-4 py-1.5 rounded text-xs font-bold transition-all bg-emerald-600 text-white shadow";
        picker.style.display = 'none';
        jsonLd.style.display = 'none';
        sideMeta.style.display = 'none';
        sidePal.classList.remove('hidden');
        monCtrls.style.display = 'none';
        codeBox.classList.remove('hidden');
        document.getElementById('designer-bg-image').style.display = 'block';
        document.getElementById('canvas-dim').textContent = `Resolution: ${state.designerGridW}x${state.designerGridH}`;
        generateLayoutCodeString();
      }

      state.selectedAsset = null;
      render();
    }

    function changeActiveLayout(id) {
      state.activeLayoutId = id;
      state.playbackIndex = 0;
      state.timeseries = generateSimulatedTelemetry(id);
      
      // Update metadata pane
      const layout = state.layouts.find(l => l.id === id);
      document.getElementById('meta-title').textContent = layout.name;
      document.getElementById('meta-desc').textContent = layout.description;
      document.getElementById('schema-key-footer').textContent = layout.id;

      // Reset Timeline bounds
      document.getElementById('playback-scrubber').max = state.timeseries.length - 1;
      document.getElementById('playback-scrubber').value = 0;

      state.selectedAsset = null;
      render();
    }

    function changePlaybackSpeed(speed) {
      state.playbackSpeed = Number(speed);
    }

    function scrubTimeline(index) {
      state.playbackIndex = Number(index);
      state.isPlaying = false;
      document.getElementById('btn-play-pause').textContent = 'PLAY';
      render();
    }

    function stepFrame() {
      state.playbackIndex = (state.playbackIndex + 1) % state.timeseries.length;
      render();
    }

    function resetPlayback() {
      state.playbackIndex = 0;
      render();
    }

    function togglePlayback() {
      state.isPlaying = !state.isPlaying;
      document.getElementById('btn-play-pause').textContent = state.isPlaying ? 'PAUSE' : 'PLAY';
      if (state.isPlaying) {
        runPlaybackLoop();
      }
    }

    function runPlaybackLoop() {
      if (state.isPlaying && state.viewMode === 'monitor') {
        state.playbackIndex = (state.playbackIndex + 1) % state.timeseries.length;
        render();
        // Dynamic timeout based on playback hertz
        setTimeout(runPlaybackLoop, 2000 / state.playbackSpeed);
      }
    }

    function handleJsonTelemetryUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (Array.isArray(parsed) && parsed.length > 0) {
            state.timeseries = parsed;
            state.playbackIndex = 0;
            document.getElementById('playback-scrubber').max = parsed.length - 1;
            document.getElementById('playback-scrubber').value = 0;
            alert(`Loaded custom telemetry timeseries successfully! Frame size: ${parsed.length}`);
            render();
          } else {
            alert("Error: Custom telemetry must be a JSON array of timeseries frames.");
          }
        } catch(err) {
          alert("Error parsing JSON file. Please ensure correct JSON structure.");
        }
      };
      reader.readAsText(file);
    }

    // ==================== DRAW / BLUEPRINT DES_FUNCTIONS ====================
    function setDesignerTool(tool) {
      state.designerTool = tool;
      
      // Update buttons style
      const tools = ['select', 'tank', 'pump', 'valve', 'scale', 'pipe'];
      tools.forEach(t => {
        const el = document.getElementById(`tool-${t}`);
        if (t === tool) {
          el.className = "flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-amber-600 border border-amber-500 text-white shadow-md transition-all";
        } else {
          el.className = "flex items-center justify-center gap-1.5 p-2 rounded text-xs font-bold bg-[#1e293b] border border-slate-700 hover:bg-slate-700 text-slate-300 transition-all";
        }
      });

      // Clear pipe drafting if swapping modes
      if (tool !== 'pipe') {
        state.currentPipePoints = [];
        document.getElementById('pipe-feedback').classList.add('hidden');
      } else {
        document.getElementById('pipe-feedback').classList.remove('hidden');
        document.getElementById('pipe-points-count').textContent = '0';
      }
    }

    function updateDesignerGridSize() {
      state.designerGridW = Number(document.getElementById('designer-grid-w').value);
      state.designerGridH = Number(document.getElementById('designer-grid-h').value);
      
      const svg = document.getElementById('hmi-svg');
      svg.setAttribute('viewBox', `0 0 ${state.designerGridW} ${state.designerGridH}`);
      document.getElementById('canvas-dim').textContent = `Resolution: ${state.designerGridW}x${state.designerGridH}`;
    }

    function handleBlueprintUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        state.designerBlueprintUrl = evt.target.result;
        const img = document.getElementById('designer-bg-image');
        img.setAttribute('href', state.designerBlueprintUrl);
        img.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }

    function handleCanvasInteraction(e) {
      if (state.viewMode === 'monitor') return;

      const svg = document.getElementById('hmi-svg');
      const rect = svg.getBoundingClientRect();
      
      // Map screen coordinates relative to SVG coordinate grid scale
      const x = Math.round(((e.clientX - rect.left) / rect.width) * state.designerGridW);
      const y = Math.round(((e.clientY - rect.top) / rect.height) * state.designerGridH);

      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);

      if (state.designerTool === 'pipe') {
        state.currentPipePoints.push({ x, y });
        document.getElementById('pipe-points-count').textContent = state.currentPipePoints.length;
        render();
        return;
      }

      if (state.designerTool !== 'select') {
        // Place chosen element type
        const stamp = Date.now().toString().slice(-4);
        
        if (state.designerTool === 'tank') {
          const id = `TANK_${stamp}`;
          activeLayout.sensors.push({
            id: `LVL_${id}`,
            name: `${id} Volume Register`,
            type: 'analogue',
            unit: '%',
            scaleMin: 0,
            scaleMax: 100,
            description: `Auto-generated level sensor for ${id}`
          });
          activeLayout.tanks.push({
            id: `LVL_${id}`,
            name: `Storage ${id}`,
            levelSensorId: `LVL_${id}`,
            x: x - 50,
            y: y - 80,
            width: 100,
            height: 160,
            maxCapacity: 5000,
            unit: 'Liters'
          });
          selectAsset('tank', `LVL_${id}`);
        } 
        
        else if (state.designerTool === 'valve') {
          const id = `VLV_${stamp}`;
          activeLayout.sensors.push({
            id: id,
            name: `Valve Position ${id}`,
            type: 'digital',
            description: `Solenoid actuator switch tag.`
          });
          activeLayout.valves.push({
            id: id,
            name: `Valve ${id}`,
            controlSensorId: id,
            x: x - 20,
            y: y - 20,
            width: 40,
            height: 40,
            orientation: 'horizontal'
          });
          selectAsset('valve', id);
        }

        else if (state.designerTool === 'pump') {
          const id = `PMP_${stamp}`;
          activeLayout.sensors.push({
            id: id,
            name: `Feed Impeller ${id}`,
            type: 'digital',
            description: `Motor control contact register.`
          });
          activeLayout.pumps.push({
            id: id,
            name: `Pump ${id}`,
            controlSensorId: id,
            x: x - 30,
            y: y - 30,
            width: 60,
            height: 60,
            flowDirection: 'right'
          });
          selectAsset('pump', id);
        }

        else if (state.designerTool === 'scale') {
          const id = `SNS_${stamp}`;
          activeLayout.sensors.push({
            id: id,
            name: `Process Metric ${id}`,
            type: 'analogue',
            unit: 'bar',
            scaleMin: 0,
            scaleMax: 10,
            thresholds: { warningHigh: 8.0 },
            description: `Auto-calibrated pressure transmitter.`
          });
          activeLayout.sensorOverlays.push({
            sensorId: id,
            x: x,
            y: y,
            showScale: true
          });
          selectAsset('scale', id);
        }

        // Return to select cursor
        setDesignerTool('select');
      }
    }

    function finishDrawingPipe() {
      if (state.currentPipePoints.length < 2) {
        state.currentPipePoints = [];
        setDesignerTool('select');
        return;
      }

      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const stamp = Date.now().toString().slice(-4);
      const id = `PIPE_${stamp}`;

      // Build path string: M x1 y1 L x2 y2 ...
      let pathStr = '';
      state.currentPipePoints.forEach((pt, idx) => {
        pathStr += (idx === 0 ? 'M' : 'L') + ` ${pt.x} ${pt.y} `;
      });

      activeLayout.pipes.push({
        id: id,
        path: pathStr.trim()
      });

      state.currentPipePoints = [];
      selectAsset('pipe', id);
      setDesignerTool('select');
    }

    // ==================== INSPECTOR & EDITORS ====================
    function selectAsset(type, id) {
      state.selectedAsset = { type, id };
      render();
    }

    function decommissionActiveAsset() {
      if (!state.selectedAsset) return;

      const { type, id } = state.selectedAsset;
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);

      if (type === 'tank') {
        activeLayout.tanks = activeLayout.tanks.filter(t => t.levelSensorId !== id);
        activeLayout.sensors = activeLayout.sensors.filter(s => s.id !== id);
      } else if (type === 'valve') {
        activeLayout.valves = activeLayout.valves.filter(v => v.id !== id);
        activeLayout.sensors = activeLayout.sensors.filter(s => s.id !== id);
      } else if (type === 'pump') {
        activeLayout.pumps = activeLayout.pumps.filter(p => p.id !== id);
        activeLayout.sensors = activeLayout.sensors.filter(s => s.id !== id);
      } else if (type === 'scale') {
        activeLayout.sensorOverlays = activeLayout.sensorOverlays.filter(s => s.sensorId !== id);
        activeLayout.sensors = activeLayout.sensors.filter(s => s.id !== id);
      } else if (type === 'pipe') {
        activeLayout.pipes = activeLayout.pipes.filter(p => p.id !== id);
      }

      state.selectedAsset = null;
      render();
    }

    function updateActiveAssetField(field, value) {
      if (!state.selectedAsset) return;
      const { type, id } = state.selectedAsset;
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);

      let target = null;
      if (type === 'tank') target = activeLayout.tanks.find(t => t.levelSensorId === id);
      else if (type === 'valve') target = activeLayout.valves.find(v => v.id === id);
      else if (type === 'pump') target = activeLayout.pumps.find(p => p.id === id);
      else if (type === 'scale') target = activeLayout.sensorOverlays.find(s => s.sensorId === id);
      else if (type === 'pipe') target = activeLayout.pipes.find(p => p.id === id);

      if (target) {
        target[field] = value;
        render();
      }
    }

    function updateActiveSensorField(field, value) {
      if (!state.selectedAsset) return;
      const { id } = state.selectedAsset;
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const sensor = activeLayout.sensors.find(s => s.id === id);
      
      if (sensor) {
        sensor[field] = value;
        render();
      }
    }

    function updateActiveSensorThreshold(field, value) {
      if (!state.selectedAsset) return;
      const { id } = state.selectedAsset;
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const sensor = activeLayout.sensors.find(s => s.id === id);
      
      if (sensor) {
        if (!sensor.thresholds) sensor.thresholds = {};
        sensor.thresholds[field] = value;
        render();
      }
    }

    function generateLayoutCodeString() {
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const cleanOutput = {
        ...activeLayout,
        viewBox: `0 0 ${state.designerGridW} ${state.designerGridH}`,
        defaultTimeseries: [] // omit for brevity
      };

      const blockStr = `export const customLayout = ${JSON.stringify(cleanOutput, null, 2)};`;
      document.getElementById('output-layout-json').value = blockStr;
    }

    function copyLayoutCode() {
      const txt = document.getElementById('output-layout-json');
      txt.select();
      document.execCommand('copy');
      alert("HMI Layout code copied directly to clipboard!");
    }

    // ==================== RENDERING PIPELINE ENGINE ====================
    function render() {
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const activeFrame = state.timeseries[state.playbackIndex];
      const values = activeFrame ? activeFrame.values : {};
      const flags = activeFrame ? activeFrame.flags : {};

      // 1. UPDATE LABELS & CONTROLS UI
      if (state.viewMode === 'monitor') {
        document.getElementById('frame-indicator').textContent = `FRAME ${state.playbackIndex + 1}/${state.timeseries.length}`;
        document.getElementById('playback-scrubber').value = state.playbackIndex;
        document.getElementById('frame-timestamp').textContent = activeFrame ? activeFrame.timestamp : '00:00:00';
        
        // Alarms count (Warnings or Bads)
        let activeAlarmsCount = 0;
        if (activeFrame && activeFrame.flags) {
          activeAlarmsCount = Object.values(activeFrame.flags).filter(f => f !== null).length;
        }

        const alarmEl = document.getElementById('stat-alarms-active');
        if (activeAlarmsCount > 0) {
          alarmEl.textContent = `${activeAlarmsCount} ACTIVE`;
          alarmEl.className = "font-mono font-bold text-sm text-rose-500 animate-pulse";
          document.getElementById('status-glow').className = "w-2.5 h-2.5 rounded-full bg-rose-500 shadow-[0_0_8px_#f43f5e]";
        } else {
          alarmEl.textContent = "0 ACT";
          alarmEl.className = "font-mono font-bold text-sm text-emerald-400";
          document.getElementById('status-glow').className = "w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981]";
        }
        document.getElementById('stat-tags-count').textContent = activeLayout.sensors.length;
      }

      // 2. RENDER PIPES
      const pipesGroup = document.getElementById('pipes-group');
      let pipesHtml = '';
      activeLayout.pipes.forEach(p => {
        const isActive = p.activeSensorId ? values[p.activeSensorId] === 1 : false;
        const color = isActive ? '#38bdf8' : '#334155';
        const isSelected = state.selectedAsset && state.selectedAsset.type === 'pipe' && state.selectedAsset.id === p.id;
        const strokeColor = isSelected ? '#eab308' : color;

        pipesHtml += `
          <g onclick="selectAsset('pipe', '${p.id}'); event.stopPropagation();" class="cursor-pointer">
            <path d="${p.path}" fill="none" stroke="#0f172a" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="${p.path}" fill="none" stroke="${strokeColor}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"
              ${isActive ? 'stroke-dasharray="6, 6"' : ''}/>
          </g>
        `;
      });

      // Draw in-progress pipe drafting nodes if in Designer Pipe mode
      if (state.viewMode === 'designer' && state.designerTool === 'pipe') {
        state.currentPipePoints.forEach((pt, idx) => {
          pipesHtml += `<circle cx="${pt.x}" cy="${pt.y}" r="5" fill="#f59e0b"/>`;
          if (idx > 0) {
            const prev = state.currentPipePoints[idx - 1];
            pipesHtml += `<line x1="${prev.x}" y1="${prev.y}" x2="${pt.x}" y2="${pt.y}" stroke="#f59e0b" stroke-width="2"/>`;
          }
        });
      }
      pipesGroup.innerHTML = pipesHtml;

      // 3. RENDER TANKS
      const tanksGroup = document.getElementById('tanks-group');
      let tanksHtml = '';
      activeLayout.tanks.forEach(t => {
        const levelSensor = activeLayout.sensors.find(s => s.id === t.levelSensorId);
        const rawVal = values[t.levelSensorId];
        const hasVal = rawVal !== undefined && rawVal !== null;
        
        const percent = hasVal 
          ? Math.max(0, Math.min(100, levelSensor.scaleMin !== undefined && levelSensor.scaleMax !== undefined
            ? ((rawVal - levelSensor.scaleMin) / (levelSensor.scaleMax - levelSensor.scaleMin)) * 100
            : rawVal))
          : 0;

        const liquidH = (percent / 100) * (t.height - 12);
        const liquidY = t.y + t.height - liquidH - 4;
        const isSelected = state.selectedAsset && state.selectedAsset.type === 'tank' && state.selectedAsset.id === t.levelSensorId;

        tanksHtml += `
          <g onclick="selectAsset('tank', '${t.levelSensorId}'); event.stopPropagation();" class="cursor-pointer">
            <!-- Tank Container -->
            <rect x="${t.x}" y="${t.y}" width="${t.width}" height="${t.height}" rx="6" fill="#111622" stroke="${isSelected ? '#eab308' : '#475569'}" stroke-width="2" />
            <!-- Liquid Overlay -->
            <rect x="${t.x + 4}" y="${liquidY}" width="${t.width - 8}" height="${liquidH}" rx="3" fill="${t.color || '#38bdf8'}" opacity="0.6" />
            <!-- Text Info -->
            <text x="${t.x + t.width/2}" y="${t.y + 25}" text-anchor="middle" fill="#94a3b8" class="font-sans text-[10px] font-bold tracking-wider uppercase">${t.name}</text>
            <text x="${t.x + t.width/2}" y="${t.y + t.height/2 + 8}" text-anchor="middle" fill="#f8fafc" class="font-mono text-base font-bold">${hasVal ? rawVal + (levelSensor.unit || '%') : '--%'}</text>
            <text x="${t.x + t.width/2}" y="${t.y + t.height - 15}" text-anchor="middle" fill="#64748b" class="font-mono text-[9px]">Cap: ${t.maxCapacity} ${t.unit}</text>
          </g>
        `;
      });
      tanksGroup.innerHTML = tanksHtml;

      // 4. RENDER VALVES
      const valvesGroup = document.getElementById('valves-group');
      let valvesHtml = '';
      activeLayout.valves.forEach(v => {
        const valSensor = activeLayout.sensors.find(s => s.id === v.controlSensorId);
        const isOpen = values[v.controlSensorId] === 1;
        const isSelected = state.selectedAsset && state.selectedAsset.type === 'valve' && state.selectedAsset.id === v.id;
        const fillCol = isOpen ? '#10b981' : '#f43f5e';
        const cx = v.x + v.width/2;
        const cy = v.y + v.height/2;

        valvesHtml += `
          <g onclick="selectAsset('valve', '${v.id}'); event.stopPropagation();" class="cursor-pointer"
             onmouseenter="showTooltip(event, '${v.controlSensorId}')" onmousemove="moveTooltip(event)" onmouseleave="hideTooltip()">
            <polygon points="${v.x},${v.y} ${cx},${cy} ${v.x},${v.y + v.height}" fill="${fillCol}" stroke="${isSelected ? '#eab308' : '#334155'}" stroke-width="1.5"/>
            <polygon points="${v.x + v.width},${v.y} ${cx},${cy} ${v.x + v.width},${v.y + v.height}" fill="${fillCol}" stroke="${isSelected ? '#eab308' : '#334155'}" stroke-width="1.5"/>
            <circle cx="${cx}" cy="${cy}" r="4" fill="#0f172a" />
            <!-- Valve Stem line -->
            <line x1="${cx}" y1="${cy}" x2="${cx}" y2="${v.y - 10}" stroke="#475569" stroke-width="2" />
            <line x1="${cx - 8}" y1="${v.y - 10}" x2="${cx + 8}" y2="${v.y - 10}" stroke="#475569" stroke-width="3" />
            <!-- Label -->
            <text x="${cx}" y="${v.y + v.height + 12}" text-anchor="middle" fill="#94a3b8" class="font-mono text-[9px] font-semibold">${v.id}</text>
          </g>
        `;
      });
      valvesGroup.innerHTML = valvesHtml;

      // 5. RENDER PUMPS
      const pumpsGroup = document.getElementById('pumps-group');
      let pumpsHtml = '';
      activeLayout.pumps.forEach(p => {
        const isSelected = state.selectedAsset && state.selectedAsset.type === 'pump' && state.selectedAsset.id === p.id;
        const isTurnedOn = values[p.controlSensorId] === 1;
        const cx = p.x + p.width/2;
        const cy = p.y + p.height/2;

        pumpsHtml += `
          <g onclick="selectAsset('pump', '${p.id}'); event.stopPropagation();" class="cursor-pointer"
             onmouseenter="showTooltip(event, '${p.controlSensorId}')" onmousemove="moveTooltip(event)" onmouseleave="hideTooltip()">
            <circle cx="${cx}" cy="${cy}" r="${p.width/2}" fill="#111622" stroke="${isSelected ? '#eab308' : isTurnedOn ? '#10b981' : '#475569'}" stroke-width="3" />
            <g id="impeller-${p.id}">
              <line x1="${cx}" y1="${cy - p.width/3}" x2="${cx}" y2="${cy + p.width/3}" stroke="${isTurnedOn ? '#34d399' : '#475569'}" stroke-width="2" />
              <line x1="${cx - p.width/3}" y1="${cy}" x2="${cx + p.width/3}" y2="${cy}" stroke="${isTurnedOn ? '#34d399' : '#475569'}" stroke-width="2" />
            </g>
            <circle cx="${cx}" cy="${cy}" r="4" fill="#cbd5e1" />
            <!-- ID Label -->
            <text x="${cx}" y="${p.y + p.height + 12}" text-anchor="middle" fill="#cbd5e1" class="font-mono text-[9px] font-semibold">${p.id}</text>
          </g>
        `;
      });
      pumpsGroup.innerHTML = pumpsHtml;

      // 6. RENDER SCALE GAUGES & PLACED TAG OVERLAYS
      const sensorsGroup = document.getElementById('sensors-group');
      let sensorsHtml = '';
      activeLayout.sensorOverlays.forEach(overlay => {
        const sensor = activeLayout.sensors.find(s => s.id === overlay.sensorId);
        if (!sensor) return;

        const val = values[overlay.sensorId];
        const flag = flags[overlay.sensorId];
        const isSelected = state.selectedAsset && state.selectedAsset.type === 'scale' && state.selectedAsset.id === overlay.sensorId;
        const min = sensor.scaleMin ?? 0;
        const max = sensor.scaleMax ?? 100;
        
        let strokeColor = isSelected ? '#eab308' : '#475569';
        let flagCol = '#cbd5e1';
        let alertMarker = '';

        if (flag === 'W') {
          strokeColor = '#f59e0b';
          flagCol = '#f59e0b';
          alertMarker = `<circle cx="85" cy="2" r="5" fill="#f59e0b" class="animate-pulse" />`;
        } else if (flag === 'B') {
          strokeColor = '#f43f5e';
          flagCol = '#f43f5e';
          alertMarker = `<circle cx="85" cy="2" r="5" fill="#f43f5e" class="animate-ping" />`;
        }

        // Horizontal Pointer Gauge logic (80px axis height)
        let ptrY = 80;
        if (sensor.type === 'analogue' && val !== undefined) {
          ptrY = 80 - ((Math.max(min, Math.min(max, val)) - min) / (max - min)) * 80;
        }

        sensorsHtml += `
          <g onclick="selectAsset('scale', '${overlay.sensorId}'); event.stopPropagation();" class="cursor-pointer"
             onmouseenter="showTooltip(event, '${overlay.sensorId}')" onmousemove="moveTooltip(event)" onmouseleave="hideTooltip()">
            <!-- Vertical calibration axis scale -->
            ${overlay.showScale && sensor.type === 'analogue' ? `
              <g transform="translate(${overlay.x - 30}, ${overlay.y - 40})">
                <rect x="0" y="0" width="4" height="80" rx="2" fill="#1e293b" />
                <polygon points="4,${ptrY - 4} 12,${ptrY} 4,${ptrY + 4}" fill="${flag ? flagCol : '#10b981'}" />
                <text x="-6" y="5" fill="#64748b" font-size="8" text-anchor="end" class="font-mono">${max}</text>
                <text x="-6" y="85" fill="#64748b" font-size="8" text-anchor="end" class="font-mono">${min}</text>
              </g>
            ` : ''}

            <!-- Value Display box -->
            <rect x="${overlay.x}" y="${overlay.y - 12}" width="95" height="26" rx="4" fill="#0f172a" stroke="${strokeColor}" stroke-width="${flag ? 2 : 1.2}" />
            <text x="${overlay.x + 8}" y="${overlay.y - 16}" fill="#94a3b8" class="font-mono text-[9px] font-semibold">${sensor.id}</text>
            <text x="${overlay.x + 40}" y="${overlay.y + 5}" text-anchor="middle" fill="${flag ? flagCol : '#f8fafc'}" class="font-mono text-xs font-bold">
              ${val !== undefined ? `${val} ${sensor.unit || ''}` : 'No Data'}
            </text>
            ${alertMarker}
          </g>
        `;
      });
      sensorsGroup.innerHTML = sensorsHtml;

      // 7. SYNC DETAILED INSPECTOR PROPERTIES PANE
      renderInspector();

      // Regenerate config code output string if in designer
      if (state.viewMode === 'designer') {
        generateLayoutCodeString();
      }
    }

    // ==================== ASSET DETAILS INSPECTOR POPULATOR ====================
    function renderInspector() {
      const emptyState = document.getElementById('inspector-empty');
      const formState = document.getElementById('inspector-form');
      const decomBtn = document.getElementById('btn-decommission');

      if (!state.selectedAsset) {
        emptyState.classList.remove('hidden');
        formState.classList.add('hidden');
        decomBtn.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      formState.classList.remove('hidden');
      decomBtn.classList.remove('hidden');

      const { type, id } = state.selectedAsset;
      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const sensor = activeLayout.sensors.find(s => s.id === id);

      document.getElementById('inspector-asset-type').textContent = type.toUpperCase();
      document.getElementById('inspector-asset-tag').textContent = id;

      // Reset nested specific fields visibility
      document.getElementById('inspect-valve-fields').classList.add('hidden');
      document.getElementById('inspect-pump-fields').classList.add('hidden');
      document.getElementById('inspect-tank-fields').classList.add('hidden');
      document.getElementById('inspect-sensor-fields').classList.add('hidden');

      if (type === 'tank') {
        const tank = activeLayout.tanks.find(t => t.levelSensorId === id);
        if (tank) {
          document.getElementById('inspect-tank-fields').classList.remove('hidden');
          document.getElementById('inspect-label').value = tank.name;
          document.getElementById('inspect-tank-cap').value = tank.maxCapacity;
          document.getElementById('inspect-tank-unit').value = tank.unit;
        }
      } 
      
      else if (type === 'valve') {
        const valve = activeLayout.valves.find(v => v.id === id);
        if (valve) {
          document.getElementById('inspect-valve-fields').classList.remove('hidden');
          document.getElementById('inspect-label').value = valve.name;
          document.getElementById('inspect-valve-orient').value = valve.orientation || 'horizontal';
        }
      }

      else if (type === 'pump') {
        const pump = activeLayout.pumps.find(p => p.id === id);
        if (pump) {
          document.getElementById('inspect-pump-fields').classList.remove('hidden');
          document.getElementById('inspect-label').value = pump.name;
          document.getElementById('inspect-pump-flow').value = pump.flowDirection || 'right';
        }
      }

      else if (type === 'scale') {
        const overlay = activeLayout.sensorOverlays.find(s => s.sensorId === id);
        if (overlay) {
          document.getElementById('inspect-label').value = sensor ? sensor.name : '';
        }
      }

      // Populate analogue limits calibrator fields if analogue sensor type
      if (sensor) {
        document.getElementById('inspect-description').value = sensor.description || '';
        
        if (sensor.type === 'analogue') {
          document.getElementById('inspect-sensor-fields').classList.remove('hidden');
          document.getElementById('inspect-scale-min').value = sensor.scaleMin ?? 0;
          document.getElementById('inspect-scale-max').value = sensor.scaleMax ?? 100;
          document.getElementById('inspect-warn-low').value = sensor.thresholds?.warningLow ?? '';
          document.getElementById('inspect-warn-high').value = sensor.thresholds?.warningHigh ?? '';
        }
      }
    }

    // ==================== PROCESS MOUSE TOOLTIP INJECTOR ====================
    function showTooltip(e, sensorId) {
      if (state.viewMode === 'designer') return;

      const activeLayout = state.layouts.find(l => l.id === state.activeLayoutId);
      const sensor = activeLayout.sensors.find(s => s.id === sensorId);
      if (!sensor) return;

      const activeFrame = state.timeseries[state.playbackIndex];
      const val = activeFrame ? activeFrame.values[sensorId] : undefined;
      const flag = activeFrame ? activeFrame.flags[sensorId] : null;

      let flagLabel = '<span class="text-emerald-400 font-semibold uppercase tracking-wider">NORMAL</span>';
      if (flag === 'W') flagLabel = '<span class="text-amber-400 font-bold tracking-widest">⚠️ WARNING</span>';
      else if (flag === 'B') flagLabel = '<span class="text-rose-400 font-bold tracking-widest animate-pulse">🛑 ALARM BAD</span>';

      const tooltip = document.getElementById('hmi-tooltip');
      tooltip.innerHTML = `
        <div class="border-b border-slate-700 pb-1.5 mb-2 flex items-center justify-between">
          <span class="font-mono text-[9px] font-bold text-slate-400">${sensor.id}</span>
          ${flagLabel}
        </div>
        <p class="text-slate-300 text-[10px] leading-relaxed mb-2">${sensor.description || 'No register details'}</p>
        <div class="space-y-1 pt-1.5 border-t border-slate-800 font-mono text-[10px]">
          <div class="flex justify-between">
            <span class="text-slate-500">Live Telemetry:</span>
            <span class="text-white font-bold">${val !== undefined ? `${val} ${sensor.unit || ''}` : 'No Data'}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Signal Code:</span>
            <span class="text-slate-400 capitalize">${sensor.type}</span>
          </div>
        </div>
      `;
      tooltip.style.opacity = '1';
    }

    function moveTooltip(e) {
      const tooltip = document.getElementById('hmi-tooltip');
      const bounding = e.currentTarget.ownerSVGElement.getBoundingClientRect();
      const x = e.clientX - bounding.left + 15;
      const y = e.clientY - bounding.top + 15;
      tooltip.style.left = `${x}px`;
      tooltip.style.top = `${y}px`;
    }

    function hideTooltip() {
      document.getElementById('hmi-tooltip').style.opacity = '0';
    }

    // RUN THE BOOTSTRAP INITIALIZATION ON LOAD
    window.onload = init;
  </script>
</body>
</html>
