        function loadSelectedMonth() {
            const selectVal = document.getElementById('month-select').value;
            currentMonthYear = selectVal;
            const entry = pmapData.find(d => d.monthyear === selectVal);
            if (!entry) return;

            entry.kpis.forEach((item, idx) => {
                const radios = document.getElementsByName(`kpi-score-${idx}`);
                for (let radio of radios) {
                    radio.checked = (parseInt(radio.value, 10) === item.score);
                }
                document.getElementById(`kpi-just-${idx}`).value = item.justification || "";
                document.getElementById(`kpi-conc-${idx}`).value = item.concern || "";
            });

            updateHeaderDate();
            calculateScores();
