            autoSaveCurrentMonth();
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(pmapData, null, 2));
            const dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", dataStr);
            dlAnchor.setAttribute("download", `pmap_export_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
        }

        function importJSON(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    if (Array.isArray(parsed) && parsed.length > 0 && parsed[0].monthyear && parsed[0].kpis) {
                        pmapData = parsed;
                        currentMonthYear = pmapData[0].monthyear;
                        populateMonthDropdown();
                        loadSelectedMonth();
                        alert("Data successfully imported!");
                    } else {
                        alert("Invalid JSON format.");
                    }
                } catch (err) {
                    alert("Error parsing JSON file: " + err.message);
                }
            };
            reader.readAsText(file);
