                barGroup.className = 'timeline-bar-group';
                barGroup.innerHTML = '<div class="timeline-bar-val">' + itemTotal + ' (' + itemPct.toFixed(0) + '%)</div>' +
                    '<div class="timeline-bar" style="height: ' + Math.max(8, itemPct) + '%; background-color: ' + color + ';"></div>' +
                    '<span class="timeline-label">' + item.monthyear + '</span>';
                chart.appendChild(barGroup);
            });

            const tbody = document.getElementById('report-table-body');
            tbody.innerHTML = '';
            const prevEntry = selectedIndex > 0 ? pmapData[selectedIndex - 1] : null;

            entry.kpis.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'clickable-row';
                tr.onclick = () => openKpiModal(item.kpi);

                let chevronHtml = '<span class="chevron chevron-same">-</span>';
                if (prevEntry) {
                    const prevKpi = prevEntry.kpis.find(k => k.kpi === item.kpi);
                    if (prevKpi) {
                        if (item.score > prevKpi.score) chevronHtml = '<span class="chevron chevron-up">▲</span>';
                        else if (item.score < prevKpi.score) chevronHtml = '<span class="chevron chevron-down">▼</span>';
                    }
                }

                let miniChipsHtml = '<div class="kpi-trend-cells">';
                windowEntries.forEach(wItem => {
                    const wKpi = wItem.kpis.find(k => k.kpi === item.kpi);
                    const sc = wKpi ? wKpi.score : 1;
                    miniChipsHtml += '<div class="mini-chip chip-' + sc + '" title="' + wItem.monthyear + ': ' + sc + '">' + sc + '</div>';
                });
                miniChipsHtml += '</div>';

                tr.innerHTML = '<td><strong>' + item.kpi + '</strong></td>' +
                    '<td style="text-align: center;"><strong>' + item.score + '</strong> ' + chevronHtml + '</td>' +
                    '<td>' + miniChipsHtml + '</td>' +
                    '<td>' + escapeHTML(item.justification || '-') + '</td>' +
                    '<td>' + escapeHTML(item.concern || '-') + '</td>';
                tbody.appendChild(tr);
            });
        }

        function openKpiModal(kpiName) {
            document.getElementById('modal-kpi-title').innerText = 'KPI Detail History: ' + kpiName;
            const chart = document.getElementById('modal-kpi-timeline');
            chart.innerHTML = '';
            const chipColors = { 5: '#15803d', 4: '#22c55e', 3: '#f59e0b', 2: '#f97316', 1: '#ef4444' };

            pmapData.forEach(entry => {
                const kpiObj = entry.kpis.find(k => k.kpi === kpiName);
                const score = kpiObj ? kpiObj.score : 1;
                const pct = (score / 5) * 100;
                const barGroup = document.createElement('div');
                barGroup.className = 'timeline-bar-group';
                barGroup.innerHTML = '<div class="timeline-bar-val">' + score + '/5</div>' +
                    '<div class="timeline-bar" style="height: ' + pct + '%; background-color: ' + chipColors[score] + ';"></div>' +
                    '<span class="timeline-label">' + entry.monthyear + '</span>';
                chart.appendChild(barGroup);
            });

            const tbody = document.getElementById('modal-kpi-table-body');
            tbody.innerHTML = '';
            pmapData.forEach(entry => {
                const kpiObj = entry.kpis.find(k => k.kpi === kpiName);
                if (!kpiObj) return;
                const tr = document.createElement('tr');
                tr.innerHTML = '<td><strong>' + entry.monthyear + '</strong></td>' +
                    '<td style="text-align: center;">' + kpiObj.score + ' / 5</td>' +
                    '<td>' + escapeHTML(kpiObj.justification || '-') + '</td>' +
                    '<td>' + escapeHTML(kpiObj.concern || '-') + '</td>';
                tbody.appendChild(tr);
            });
            document.getElementById('kpi-modal').classList.remove('hidden');
        }

        function openOverallHistoryModal() {
            const chart = document.getElementById('modal-overall-timeline');
            chart.innerHTML = '';
            const tbody = document.getElementById('modal-overall-table-body');
            tbody.innerHTML = '';

            pmapData.forEach(entry => {
                const total = entry.kpis.reduce((acc, k) => acc + k.score, 0);
                let pct = ((total - 7) / 28) * 100;
                if (pct < 0) pct = 0; if (pct > 100) pct = 100;
                const rag = getRAGStatus(pct);
                const color = rag.label === 'GREEN' ? '#22c55e' : (rag.label === 'AMBER' ? '#f59e0b' : '#ef4444');

                const barGroup = document.createElement('div');
                barGroup.className = 'timeline-bar-group';
                barGroup.innerHTML = '<div class="timeline-bar-val">' + total + ' (' + pct.toFixed(0) + '%)</div>' +
                    '<div class="timeline-bar" style="height: ' + Math.max(8, pct) + '%; background-color: ' + color + ';"></div>' +
                    '<span class="timeline-label">' + entry.monthyear + '</span>';
                chart.appendChild(barGroup);

                const tr = document.createElement('tr');
                tr.innerHTML = '<td><strong>' + entry.monthyear + '</strong></td>' +
                    '<td style="text-align: center;"><strong>' + total + '</strong> / 35</td>' +
                    '<td style="text-align: center;">' + pct.toFixed(1) + '%</td>' +
                    '<td style="text-align: center;"><span class="rag-badge ' + rag.class + '">' + rag.label + '</span></td>';
                tbody.appendChild(tr);
            });

            document.getElementById('overall-modal').classList.remove('hidden');
        }

        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
        function escapeHTML(str) { return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)); }
    <\/script>
</body>
</html>`;

            const blob = new Blob([supplierHTML], { type: "text/html" });
            const dlAnchor = document.createElement('a');
            dlAnchor.href = URL.createObjectURL(blob);
            dlAnchor.download = `PMAP_Supplier_Report_${new Date().toISOString().slice(0,10)}.html`;
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
        }
    </script>
