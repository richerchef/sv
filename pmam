        function getRAGStatus(pct) {
            if (pct >= 70) return { label: 'GREEN', class: 'rag-green' };
            if (pct >= 40) return { label: 'AMBER', class: 'rag-amber' };
            return { label: 'RED', class: 'rag-red' };
        }

        function initReportView() {
            pmapData.sort((a,b) => a.monthyear.localeCompare(b.monthyear));
            
            const slider = document.getElementById('report-slider');
            slider.min = 0;
            slider.max = Math.max(0, pmapData.length - 1);
            
            const currentIndex = pmapData.findIndex(d => d.monthyear === currentMonthYear);
            slider.value = currentIndex >= 0 ? currentIndex : 0;

            updateReportView(parseInt(slider.value, 10));
        }

        function updateReportView(selectedIndex) {
            const entry = pmapData[selectedIndex];
            if (!entry) return;

            currentMonthYear = entry.monthyear;
            updateHeaderDate();
            document.getElementById('slider-month-display').innerText = entry.monthyear;

            const total = entry.kpis.reduce((acc, k) => acc + k.score, 0);
            let pct = ((total - 7) / 28) * 100;
            if (pct < 0) pct = 0; if (pct > 100) pct = 100;

            const rag = getRAGStatus(pct);

            document.getElementById('rep-total-score').innerText = total;
            document.getElementById('rep-percentage').innerText = pct.toFixed(1) + '%';
            document.getElementById('rep-status').innerHTML = `<span class="rag-badge ${rag.class}">${rag.label}</span>`;

            // Limit Historical Chart to last 5 entries up to selectedIndex
            const windowStart = Math.max(0, selectedIndex - 4);
            const windowEntries = pmapData.slice(windowStart, selectedIndex + 1);

            const chart = document.getElementById('timeline-chart');
            chart.innerHTML = '';

            windowEntries.forEach(item => {
                const itemTotal = item.kpis.reduce((acc, k) => acc + k.score, 0);
                let itemPct = ((itemTotal - 7) / 28) * 100;
                if (itemPct < 0) itemPct = 0;
                
                const itemRag = getRAGStatus(itemPct);
                const color = itemRag.label === 'GREEN' ? '#22c55e' : (itemRag.label === 'AMBER' ? '#f59e0b' : '#ef4444');

                const barGroup = document.createElement('div');
                barGroup.className = 'timeline-bar-group';
                barGroup.innerHTML = `
                    <div class="timeline-bar-val">${itemTotal} (${itemPct.toFixed(0)}%)</div>
                    <div class="timeline-bar" style="height: ${Math.max(8, itemPct)}%; background-color: ${color};"></div>
                    <span class="timeline-label">${item.monthyear}</span>
                `;
                chart.appendChild(barGroup);
            });

            // Populate Table
            const tbody = document.getElementById('report-table-body');
            tbody.innerHTML = '';

            const prevEntry = selectedIndex > 0 ? pmapData[selectedIndex - 1] : null;

            entry.kpis.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'clickable-row';
                tr.onclick = () => openKpiModal(item.kpi);

                // Chevron logic vs previous entry
                let chevronHtml = '<span class="chevron chevron-same">-</span>';
                if (prevEntry) {
                    const prevKpi = prevEntry.kpis.find(k => k.kpi === item.kpi);
                    if (prevKpi) {
                        if (item.score > prevKpi.score) {
                            chevronHtml = '<span class="chevron chevron-up">▲</span>';
                        } else if (item.score < prevKpi.score) {
                            chevronHtml = '<span class="chevron chevron-down">▼</span>';
                        }
                    }
                }

                // Render KPI mini historical trend (last 5 entries)
                let miniChipsHtml = '<div class="kpi-trend-cells">';
                windowEntries.forEach(wItem => {
                    const wKpi = wItem.kpis.find(k => k.kpi === item.kpi);
                    const sc = wKpi ? wKpi.score : 1;
                    miniChipsHtml += `<div class="mini-chip chip-${sc}" title="${wItem.monthyear}: ${sc}">${sc}</div>`;
                });
                miniChipsHtml += '</div>';

                tr.innerHTML = `
                    <td><strong>${item.kpi}</strong></td>
                    <td style="text-align: center;"><strong>${item.score}</strong> ${chevronHtml}</td>
                    <td>${miniChipsHtml}</td>
                    <td>${escapeHTML(item.justification || '-')}</td>
                    <td>${escapeHTML(item.concern || '-')}</td>
                `;
                tbody.appendChild(tr);
            });
        }

