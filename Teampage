  /* ==========================================================================
     RENDER & STATE MANAGEMENT
     ========================================================================== */

  // Render Cards supporting single/multiple leads with explicit titles
  function renderTeams() {
    const container = document.getElementById('teamCardsContainer');
    container.innerHTML = teamData.map((team, index) => {
      const leads = team.members.filter(m => m.isLead);
      const nonLeads = team.members.filter(m => !m.isLead);

      const skillBarsHtml = Object.entries(team.skills).map(([skill, level]) => {
        const meta = skillScale[level] || skillScale["None"];
        return `
          <div class="skill-row">
            <div class="skill-info">
              <span>${skill}</span>
              <span class="level-badge level-${level.toLowerCase()}">${level}</span>
            </div>
            <div class="skill-bar-track">
              <div class="skill-bar-fill" style="width:${meta.pct}; background:${team.color}"></div>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="sub-team-card" id="card-${index}" data-state="0" onclick="cycleCardState('${index}')">
          <div class="team-header">
            <span class="team-name">${team.name}</span>
            <span class="team-badge" style="background:${team.color}22; color:${team.color}; border: 1px solid ${team.color}">
              ${team.members.length} Members
            </span>
          </div>
          
          <div class="leader-box">
            <span class="leader-title">${leads.length > 1 ? 'Team Leads:' : 'Team Lead:'}</span>
            <div class="leader-list">
              ${leads.map(l => `
                <div class="leader-tag">
                  <strong>${l.name}</strong>
                  <span class="leader-role-span">${l.role}</span>
                </div>
              `).join('')}
            </div>
          </div>

          <!-- Level 1: Non-Lead Roster -->
          <div class="expand-section members-expand">
            <ul class="member-list">
              ${nonLeads.map(m => `
                <li class="member-item">
                  <span>${m.name}</span>
                  <span class="member-role">${m.role}</span>
                </li>
              `).join('')}
            </ul>
          </div>

          <!-- Level 2: Skill Bars -->
          <div class="expand-section skills-expand">
            ${skillBarsHtml}
          </div>

          <span class="card-state-indicator" id="indicator-${index}">Click to expand roster</span>
        </div>
      `;
    }).join('');
  }

  function cycleCardState(index) {
    const card = document.getElementById(`card-${index}`);
    let currentState = parseInt(card.getAttribute('data-state'));
    let nextState = (currentState + 1) % 3;
    applyCardState(index, nextState);
  }

  function applyCardState(index, state) {
    const card = document.getElementById(`card-${index}`);
    const indicator = document.getElementById(`indicator-${index}`);
    card.setAttribute('data-state', state);

    if (state === 0) {
      indicator.textContent = "Click to expand roster";
    } else if (state === 1) {
      indicator.textContent = "Click again to show skills";
    } else if (state === 2) {
      indicator.textContent = "Click to collapse";
    }
  }

  function setAllCardsState(targetState) {
    teamData.forEach((_, index) => {
      applyCardState(index, targetState);
    });
  }

  // Render Table
  function renderSkillTable() {
    const headerRow = document.getElementById('tableHeader');
    const tableBody = document.getElementById('tableBody');
    const allSkillKeys = Object.keys(teamData[0].skills);

    teamData.forEach((team, colIdx) => {
      const th = document.createElement('th');
      th.id = `th-team-${colIdx}`;
      th.innerHTML = `<span class="th-title" style="color:${team.color}">${team.name}</span> <span class="sort-icon">↕</span>`;
      th.onclick = () => sortTable(colIdx + 1);
      headerRow.appendChild(th);
    });

    tableBody.innerHTML = allSkillKeys.map(skill => {
      const columns = teamData.map((team, colIdx) => {
        const level = team.skills[skill] || "None";
        const meta = skillScale[level] || skillScale["None"];

        return `
          <td data-sort="${meta.val}" class="td-col-${colIdx}">
            <div class="table-skill-cell">
              <div><span class="level-badge level-${level.toLowerCase()}">${level}</span></div>
              <div class="mini-bar-track">
                <div class="mini-bar-fill" style="width:${meta.pct}; background:${team.color}"></div>
              </div>
            </div>
          </td>
        `;
      }).join('');

      return `
        <tr>
          <td data-sort="${skill}"><strong style="color: #ffffff">${skill}</strong></td>
          ${columns}
        </tr>
      `;
    }).join('');

    renderRecommenderCheckboxes(allSkillKeys);
  }

  /* ==========================================================================
     TEAM RECOMMENDER LOGIC
     ========================================================================== */
  function renderRecommenderCheckboxes(skillKeys) {
    const container = document.getElementById('skillCheckboxes');
    container.innerHTML = skillKeys.map(skill => `
      <label class="skill-chip-label">
        <input type="checkbox" value="${skill}" onchange="calculateRecommendedTeams()">
        ${skill}
      </label>
    `).join('');
  }

  function calculateRecommendedTeams() {
    const checkboxes = document.querySelectorAll('#skillCheckboxes input:checked');
    const selectedSkills = Array.from(checkboxes).map(cb => cb.value);
    const statusDiv = document.getElementById('recommendStatus');

    // Reset Highlights
    teamData.forEach((_, colIdx) => {
      const th = document.getElementById(`th-team-${colIdx}`);
      th.classList.remove('recommend-match');
      const badge = th.querySelector('.match-badge');
      if (badge) badge.remove();

      document.querySelectorAll(`.td-col-${colIdx}`).forEach(td => {
        td.classList.remove('recommend-match');
      });
    });

    if (selectedSkills.length === 0) {
      statusDiv.textContent = "Select skill criteria above to see recommended teams.";
      return;
    }

    // Calculate score for each team based on selected skill values
    const scores = teamData.map((team, colIdx) => {
      let totalScore = 0;
      selectedSkills.forEach(skill => {
        const level = team.skills[skill] || "None";
        totalScore += skillScale[level].val;
      });
      return { colIdx, teamName: team.name, score: totalScore };
    });

    // Find highest score (> 0)
    scores.sort((a, b) => b.score - a.score);
    const maxScore = scores[0].score;

    if (maxScore === 0) {
      statusDiv.textContent = "No teams have capabilities matching the selected criteria.";
      return;
    }

    // Highlight top-matching team(s)
    const topTeams = scores.filter(s => s.score === maxScore);
    topTeams.forEach(match => {
      const th = document.getElementById(`th-team-${match.colIdx}`);
      th.classList.add('recommend-match');
      
      const badge = document.createElement('span');
      badge.className = 'match-badge';
      badge.textContent = 'Best Match';
      th.appendChild(badge);

      document.querySelectorAll(`.td-col-${match.colIdx}`).forEach(td => {
        td.classList.add('recommend-match');
      });
    });

    const matchNames = topTeams.map(t => t.teamName).join(', ');
    statusDiv.textContent = `Recommended Team(s): ${matchNames} (Score: ${maxScore}/${selectedSkills.length * 3})`;
  }

  // Sort Table Implementation
  let sortDirections = {};
  function sortTable(columnIndex) {
    const table = document.getElementById("skillsTable");
    const tbody = table.querySelector("tbody");
    const rows = Array.from(tbody.querySelectorAll("tr"));

    const currentDir = sortDirections[columnIndex] || 'asc';
    const newDir = currentDir === 'asc' ? 'desc' : 'asc';
    sortDirections[columnIndex] = newDir;

    rows.sort((a, b) => {
      const cellA = a.children[columnIndex].getAttribute('data-sort');
      const cellB = b.children[columnIndex].getAttribute('data-sort');

      let valA = isNaN(cellA) ? cellA : parseInt(cellA);
      let valB = isNaN(cellB) ? cellB : parseInt(cellB);

      if (valA < valB) return newDir === 'asc' ? -1 : 1;
      if (valA > valB) return newDir === 'asc' ? 1 : -1;
      return 0;
    });

    rows.forEach(row => tbody.appendChild(row));
  }

  // Floor Map Pins
  function renderMap() {
    const wrapper = document.getElementById('mapWrapper');
    const filterContainer = document.getElementById('mapFilters');

    wrapper.querySelectorAll('.map-pin').forEach(pin => pin.remove());

    teamData.forEach(team => {
      team.members.forEach(member => {
        const pin = document.createElement('div');
        pin.className = `map-pin team-pin-${team.id}`;
        pin.style.left = `${member.x}%`;
        pin.style.top = `${member.y}%`;
        pin.style.backgroundColor = team.color;

        pin.innerHTML = `
          <div class="tooltip">
            <strong>${member.name} ${member.isLead ? '👑' : ''}</strong><br>
            <span style="opacity:0.8">${member.role} (${team.name})</span>
          </div>
        `;
        wrapper.appendChild(pin);
      });
    });

    const existingFilters = filterContainer.querySelectorAll('.filter-btn:not([data-filter="all"])');
    if(existingFilters.length === 0) {
      teamData.forEach(team => {
        const btn = document.createElement('button');
        btn.className = 'filter-btn';
        btn.textContent = team.name;
        btn.setAttribute('data-filter', team.id);
        btn.addEventListener('click', (e) => filterMap(team.id, e.target));
        filterContainer.appendChild(btn);
      });
    }
  }

  function filterMap(teamId, targetBtn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    targetBtn.classList.add('active');

    document.querySelectorAll('.map-pin').forEach(pin => {
      if (teamId === 'all' || pin.classList.contains(`team-pin-${teamId}`)) {
        pin.style.display = 'block';
      } else {
        pin.style.display = 'none';
      }
    });
  }

  document.querySelector('[data-filter="all"]').addEventListener('click', (e) => filterMap('all', e.target));

  // Init
  document.addEventListener('DOMContentLoaded', () => {
    renderTeams();
    renderSkillTable();
    renderMap();
  });
</script>
