WITH CompressedBuckets AS (
    -- Step 1: Compress billions of rows into 5-minute intervals
    -- 5 minutes = 300 seconds. Dividing timeid by 300 groups rows together.
    SELECT 
        Dateid,
        (timeid / 300) * 300 AS bucket_time, 
        AVG(CAST(Channel_1 AS FLOAT)) AS chan1_activity,
        AVG(CAST(Channel_2 AS FLOAT)) AS chan2_activity,
        AVG(CAST(Channel_3 AS FLOAT)) AS chan3_activity,
        AVG(CAST(Channel_4 AS FLOAT)) AS chan4_activity
    FROM your_table_name
    WHERE Channel_1 = 1 OR Channel_2 = 1 OR Channel_3 = 1 OR Channel_4 = 1
    GROUP BY Dateid, (timeid / 300) * 300
),

ActiveBuckets AS (
    -- Step 2: Filter for buckets where a channel was actually active (mean > 0)
    SELECT 
        Dateid,
        bucket_time,
        CASE WHEN chan1_activity > 0 THEN 1 ELSE 0 END AS c1,
        CASE WHEN chan2_activity > 0 THEN 1 ELSE 0 END AS c2,
        CASE WHEN chan3_activity > 0 THEN 1 ELSE 0 END AS c3,
        CASE WHEN chan4_activity > 0 THEN 1 ELSE 0 END AS c4
    FROM CompressedBuckets
)

-- Step 3: Find the sequence across the compressed buckets
SELECT 
    b1.Dateid AS start_date,
    b1.bucket_time AS start_time_bucket,
    '1-2-3-4' AS sequence
FROM ActiveBuckets b1
JOIN ActiveBuckets b2 ON b1.Dateid = b2.Dateid AND b2.bucket_time > b1.bucket_time
JOIN ActiveBuckets b3 ON b1.Dateid = b3.Dateid AND b3.bucket_time > b2.bucket_time
JOIN ActiveBuckets b4 ON b1.Dateid = b4.Dateid AND b4.bucket_time > b3.bucket_time
WHERE b1.c1 = 1 -- Channel 1 is active in bucket 1
  AND b2.c2 = 1 -- Channel 2 is active in a later bucket
  AND b3.c3 = 1 -- Channel 3 is active in an even later bucket
  AND b4.c4 = 1 -- Channel 4 is active in the final bucket
  AND (b4.bucket_time - b1.bucket_time) <= 3600; -- All within 1 hour


WITH CombinedStates AS (
    -- Step 1: Combine channels into a single string representation
    SELECT 
        Dateid,
        timeid,
        CONCAT(
            CAST(Channel_1 AS VARCHAR),
            CAST(Channel_2 AS VARCHAR),
            CAST(Channel_3 AS VARCHAR),
            CAST(Channel_4 AS VARCHAR)
        ) AS all_test
    FROM your_table_name
    -- Keep only rows where at least one test is actually running
    WHERE Channel_1 = 1 OR Channel_2 = 1 OR Channel_3 = 1 OR Channel_4 = 1
),

DeduplicatedStates AS (
    -- Step 2: Look at the PREVIOUS row's string.
    -- If it's identical, we know it's a repeat/flicker and can filter it out.
    SELECT 
        Dateid,
        timeid,
        all_test,
        LAG(all_test, 1) OVER (ORDER BY Dateid, timeid) AS prev_test
    FROM CombinedStates
),

CleanSequence AS (
    -- Step 3: Grab only the first instance of a state change, 
    -- then look ahead at the next 3 unique states.
    SELECT 
        Dateid AS start_date,
        timeid AS start_time,
        all_test AS state_1,
        LEAD(all_test, 1) OVER (ORDER BY Dateid, timeid) AS state_2,
        LEAD(all_test, 2) OVER (ORDER BY Dateid, timeid) AS state_3,
        LEAD(all_test, 3) OVER (ORDER BY Dateid, timeid) AS state_4
    FROM DeduplicatedStates
    WHERE prev_test IS NULL OR all_test != prev_test
)

-- Step 4: Pull the instances where the exact sequence occurs
SELECT 
    start_date,
    start_time,
    '1-2-3-4' AS sequence_detected
FROM CleanSequence
WHERE state_1 = '1000'
  AND state_2 = '0100'
  AND state_3 = '0010'
  AND state_4 = '0001'
ORDER BY start_date, start_time;
