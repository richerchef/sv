WITH LinearTimestamps AS (
    -- Step 1: Filter down to ONLY when channels turn ON (1) 
    -- This instantly eliminates the "flickering" noise when channels bounce on/off
    SELECT 
        Dateid,
        timeid,
        Channel_1, Channel_2, Channel_3, Channel_4,
        -- Pure math conversion to linear seconds (No slow date parsing)
        (
            (CAST(Dateid % 10000 AS BIGINT) * 31536000) +        
            (CAST((Dateid / 10000) % 100 AS BIGINT) * 2678400) +  
            (CAST(Dateid / 1000000 AS BIGINT) * 86400) +          
            CAST(timeid AS BIGINT)                                
        ) AS linear_seconds
    FROM your_table_name
    WHERE Channel_1 = 1 OR Channel_2 = 1 OR Channel_3 = 1 OR Channel_4 = 1
),

ChannelFirstHits AS (
    -- Step 2: For every row, find the NEXT time each specific channel turns ON
    -- This handles patchy data because LEAD looks forward until it finds a match, ignoring gaps.
    SELECT 
        linear_seconds AS t1_time,
        Dateid AS start_dateid,
        timeid AS start_timeid,
        Channel_1,
        
        -- Look forward to find the next absolute time Channel 2, 3, and 4 turn ON
        MIN(CASE WHEN Channel_2 = 1 THEN linear_seconds END) OVER (
            ORDER BY linear_seconds ROWS BETWEEN 1 FOLLOWING AND 100 FOLLOWING
        ) AS t2_time,
        
        MIN(CASE WHEN Channel_3 = 1 THEN linear_seconds END) OVER (
            ORDER BY linear_seconds ROWS BETWEEN 1 FOLLOWING AND 100 FOLLOWING
        ) AS t3_time,
        
        MIN(CASE WHEN Channel_4 = 1 THEN linear_seconds END) OVER (
            ORDER BY linear_seconds ROWS BETWEEN 1 FOLLOWING AND 100 FOLLOWING
        ) AS t4_time
    FROM LinearTimestamps
)

-- Step 3: Filter for the strict 1 -> 2 -> 3 -> 4 sequence within 1 hour
SELECT 
    start_dateid,
    start_timeid,
    (t4_time - t1_time) AS total_duration_seconds,
    '1-2-3-4' AS sequence
FROM ChannelFirstHits
WHERE Channel_1 = 1                -- Start with Channel 1 turning ON
  AND t2_time > t1_time            -- Channel 2 happens after Channel 1
  AND t3_time > t2_time            -- Channel 3 happens after Channel 2
  AND t4_time > t3_time            -- Channel 4 happens after Channel 3
  AND (t4_time - t1_time) <= 3600  -- The entire sequence completes within 1 hour (3600s)
ORDER BY t1_time;


WITH RawHits AS (
    -- Step 1: Rely entirely on native columns to use your table indexes
    SELECT 
        Dateid,
        timeid,
        Channel_1, Channel_2, Channel_3, Channel_4,
        -- Identify if a row is near the end of the day (11:00 PM = 79200 seconds)
        CASE WHEN timeid >= 79200 THEN 1 ELSE 0 END AS is_late_night
    FROM your_table_name
    WHERE Channel_1 = 1 OR Channel_2 = 1 OR Channel_3 = 1 OR Channel_4 = 1
),

LookAhead AS (
    -- Step 2: Look ahead using pure indexes. 
    -- We bound the search to the next 50 rows to keep it lightning fast.
    SELECT 
        Dateid AS t1_date,
        timeid AS t1_time,
        Channel_1,
        is_late_night,
        
        -- Find the next times channels 2, 3, and 4 turn on within the same day
        MIN(CASE WHEN Channel_2 = 1 THEN timeid END) OVER (
            PARTITION BY Dateid ORDER BY timeid ROWS BETWEEN 1 FOLLOWING AND 50 FOLLOWING
        ) AS t2_time,
        
        MIN(CASE WHEN Channel_3 = 1 THEN timeid END) OVER (
            PARTITION BY Dateid ORDER BY timeid ROWS BETWEEN 1 FOLLOWING AND 50 FOLLOWING
        ) AS t3_time,
        
        MIN(CASE WHEN Channel_4 = 1 THEN timeid END) OVER (
            PARTITION BY Dateid ORDER BY timeid ROWS BETWEEN 1 FOLLOWING AND 50 FOLLOWING
        ) AS t4_time,
        
        -- Special Cross-Day Lookahead: If it's late night, look at the next chronological rows WITHOUT partition
        MIN(CASE WHEN Channel_2 = 1 THEN timeid END) OVER (
            ORDER BY Dateid, timeid ROWS BETWEEN 1 FOLLOWING AND 50 FOLLOWING
        ) AS cross_t2_time,
        MIN(CASE WHEN Channel_3 = 1 THEN timeid END) OVER (
            ORDER BY Dateid, timeid ROWS BETWEEN 1 FOLLOWING AND 50 FOLLOWING
        ) AS cross_t3_time,
        MIN(CASE WHEN Channel_4 = 1 THEN timeid END) OVER (
            ORDER BY Dateid, timeid ROWS BETWEEN 1 FOLLOWING AND 50 FOLLOWING
        ) AS cross_t4_time,
        
        -- Track the Dateid of the 4th step to see if it crossed into tomorrow
        LEAD(Dateid, 3) OVER (ORDER BY Dateid, timeid) AS t4_date
    FROM RawHits
)

-- Step 3: Combine standard results and late-night crossover results
SELECT 
    t1_date AS start_date,
    t1_time AS start_time,
    '1-2-3-4' AS sequence,
    CASE 
        WHEN is_late_night = 0 THEN (t4_time - t1_time)
        ELSE (t4_time + 86400) - t1_time -- Adds 24 hours in seconds if it crossed midnight
    END AS duration_seconds
FROM LookAhead
WHERE Channel_1 = 1
  AND (
    -- Scenario A: Standard same-day sequence
    (is_late_night = 0 
     AND t2_time > t1_time 
     AND t3_time > t2_time 
     AND t4_time > t3_time 
     AND (t4_time - t1_time) <= 3600)
    OR
    -- Scenario B: Midnight crossover sequence
    (is_late_night = 1 
     AND cross_t2_time IS NOT NULL 
     AND cross_t3_time IS NOT NULL 
     AND cross_t4_time IS NOT NULL
     -- Ensures the 4th step happened either today or tomorrow
     AND (t4_date = t1_date OR t4_date > t1_date) 
     -- Logic to ensure sequence within 1 hour across midnight
     AND ((cross_t4_time + CASE WHEN t4_date > t1_date THEN 86400 ELSE 0 END) - t1_time) <= 3600)
  )
ORDER BY t1_date, t1_time;

